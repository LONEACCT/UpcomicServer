cat > views/admin/analytics.ejs << 'ENDOFFILE'
<%- include('../partials/admin-header', { pageTitle: 'Analytics', active: 'analytics' }) %>

<div class="admin-topbar">
  <h1>Analytics</h1>
</div>

<div class="stat-grid">
  <div class="stat-card"><div class="n"><%= totalViews.toLocaleString() %></div><div class="label">Total views</div></div>
  <div class="stat-card"><div class="n"><%= totalComics %></div><div class="label">Comics</div></div>
  <div class="stat-card"><div class="n"><%= totalChapters %></div><div class="label">Chapters</div></div>
  <div class="stat-card"><div class="n"><%= totalUsers %></div><div class="label">Users</div></div>
  <div class="stat-card"><div class="n"><%= newSignupsThisWeek %></div><div class="label">New signups (7d)</div></div>
  <div class="stat-card"><div class="n"><%= activeVip %></div><div class="label">Active VIP</div></div>
  <div class="stat-card"><div class="n"><%= codesGenerated %></div><div class="label">Codes generated</div></div>
  <div class="stat-card"><div class="n"><%= codesRedeemed %></div><div class="label">Codes redeemed</div></div>
  <div class="stat-card"><div class="n"><%= totalComments %></div><div class="label">Comments</div></div>
  <div class="stat-card"><div class="n"><%= reportedComments %></div><div class="label">Reported comments</div></div>
</div>

<h2 style="font-size:16px;margin:28px 0 12px;">Top comics by views</h2>
<table class="admin-table">
  <thead>
    <tr><th>Title</th><th>Views</th><th>Rating</th></tr>
  </thead>
  <tbody>
    <% if (topComics.length === 0) { %>
      <tr class="admin-empty-row"><td colspan="3">No comics yet.</td></tr>
    <% } else { %>
      <% topComics.forEach(c => { %>
        <tr>
          <td><a href="/comic/<%= c.slug %>" target="_blank"><%= c.title %></a></td>
          <td class="mono"><%= c.views.toLocaleString() %></td>
          <td class="mono"><%= c.rating %></td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<h2 style="font-size:16px;margin:28px 0 12px;">VIP expiring in the next 3 days</h2>
<table class="admin-table">
  <thead>
    <tr><th>User</th><th>Expires</th></tr>
  </thead>
  <tbody>
    <% if (expiringSoon.length === 0) { %>
      <tr class="admin-empty-row"><td colspan="2">Nobody expiring soon.</td></tr>
    <% } else { %>
      <% expiringSoon.forEach(u => { %>
        <tr>
          <td><%= u.username %></td>
          <td class="mono"><%= formatRelativeTime(u.vip_expires_at) %></td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<%- include('../partials/admin-footer') %>
ENDOFFILE
