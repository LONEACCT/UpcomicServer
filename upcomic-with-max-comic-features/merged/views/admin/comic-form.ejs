<%- include('../partials/admin-header', { pageTitle: comic ? 'Edit Comic' : 'New Comic', active: 'comics' }) %>

<div class="admin-topbar">
  <h1><%= comic ? 'Edit comic' : 'New comic' %></h1>
  <a href="/admin/comics" class="btn btn-ghost">← Back to comics</a>
</div>

<% if (error) { %><div class="form-error" style="max-width:560px;"><%= error %></div><% } %>

<form action="<%= comic ? '/admin/comics/' + comic.id + '/edit' : '/admin/comics/new' %>" method="POST" enctype="multipart/form-data" style="max-width:560px;">
  <div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" required value="<%= comic ? comic.title : '' %>" />
  </div>

  <div class="field">
    <label for="description">Description</label>
    <textarea id="description" name="description"><%= comic ? (comic.description || '') : '' %></textarea>
  </div>

  <div class="field">
    <label for="rating">Rating (0.0 – 5.0)</label>
    <input type="number" id="rating" name="rating" min="0" max="5" step="0.1" value="<%= comic ? comic.rating : '4.5' %>" />
  </div>

  <div class="field">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="Ongoing" <%= (!comic || comic.status === 'Ongoing') ? 'selected' : '' %>>Ongoing</option>
      <option value="Completed" <%= comic && comic.status === 'Completed' ? 'selected' : '' %>>Completed</option>
    </select>
  </div>

  <div class="field">
    <label for="cover_image">Cover image</label>
    <% if (comic && comic.cover_image) { %>
      <img src="<%= comic.cover_image %>" class="thumb-40" style="width:80px;height:104px;margin-bottom:10px;" alt="" />
    <% } %>
    <input type="file" id="cover_image" name="cover_image" accept="image/*" />
    <p class="hint">JPG, PNG, WebP, or GIF. Max 10MB.</p>
  </div>

  <div class="field">
    <label for="categories">Genres</label>
    <input type="text" id="categories" name="categories" list="category-suggestions" placeholder="e.g. Romance, Drama, Mature" value="<%= categoryText %>" />
    <datalist id="category-suggestions">
      <% existingCategoryNames.forEach(name => { %><option value="<%= name %>"></option><% }) %>
    </datalist>
    <p class="hint">Type genre names separated by commas — new ones are created automatically, existing ones are reused (start typing to see suggestions).</p>
  </div>

  <div class="field">
    <div class="checkbox-row">
      <input type="checkbox" id="is_featured" name="is_featured" value="1" <%= comic && comic.is_featured ? 'checked' : '' %> />
      <label for="is_featured">Featured — show in the homepage hero carousel</label>
    </div>
  </div>

  <div class="field">
    <div class="checkbox-row">
      <input type="checkbox" id="is_trending" name="is_trending" value="1" <%= comic && comic.is_trending ? 'checked' : '' %> />
      <label for="is_trending">Trending — boost in the "Trending" sort tab</label>
    </div>
  </div>

  <button type="submit" class="btn btn-red btn-block"><%= comic ? 'Save changes' : 'Create comic' %></button>
</form>

<%- include('../partials/admin-footer') %>
