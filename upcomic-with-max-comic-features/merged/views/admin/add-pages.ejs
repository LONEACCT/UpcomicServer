<%- include('../partials/admin-header', { pageTitle: 'Add Pages', active: 'comics' }) %>

<div class="admin-topbar">
  <h1><%= chapter.title %></h1>
  <a href="/admin/comics/<%= comic.id %>/chapters" class="btn btn-ghost">← Back to chapters</a>
</div>

<form action="/admin/comics/<%= comic.id %>/chapters/<%= chapter.id %>/add-pages" method="POST" enctype="multipart/form-data" style="max-width:560px;">
  <div class="field">
    <label for="pages">Add more pages</label>
    <input type="file" id="pages" name="pages" accept="image/*" multiple />
    <p class="hint">New pages are added to the end of the chapter, in the order you select them.</p>
  </div>
  <button type="submit" class="btn btn-red btn-block">Upload pages</button>
</form>

<% if (pages.length > 0) { %>
  <h2 style="margin-top:36px;font-size:16px;">Current pages (<%= pages.length %>)</h2>
  <div class="page-thumb-grid">
    <% pages.forEach(page => { %>
      <img src="/media/page/<%= page.id %>" alt="Page <%= page.page_order %>" />
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
