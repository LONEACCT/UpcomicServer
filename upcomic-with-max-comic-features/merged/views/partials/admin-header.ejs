      <a href="/admin/codes" class="admin-nav-link <%= active === 'codes' ? 'active' : '' %>">VIP Codes</a>
      <a href="/admin/users" class="admin-nav-link <%= active === 'users' ? 'active' : '' %>">Users</a>
      <a href="/admin/comments/reported" class="admin-nav-link <%= active === 'reported-comments' ? 'active' : '' %>">Reported Comments</a>
      <a href="/" target="_blank" class="admin-nav-link">View site ↗</a>
      <form action="/admin/logout" method="POST">
