<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= siteName %> — Age Verification</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Oswald:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="age-gate">
    <div class="form-shell age-gate-card">
      <div class="wordmark" style="justify-content:center;margin-bottom:14px;"><img src="/icons/logo.png" alt="UPCOMIC" style="height:56px;width:auto;" /></div>
      <div class="motto"><%= siteMotto %></div>
      <p class="warn">This site contains adult content. You must be 18 years or older to enter.</p>
      <div class="age-gate-actions">
        <form action="/enter" method="POST">
          <button type="submit" class="btn btn-red">I'm 18 or older</button>
        </form>
        <a href="https://www.google.com" class="btn btn-outline">Leave</a>
      </div>
    </div>
  </div>
</body>
</html>
