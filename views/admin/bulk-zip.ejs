<%- include('../partials/admin-header', { pageTitle: 'Bulk ZIP Upload', active: 'comics' }) %>

<div class="admin-topbar">
  <h1>Bulk ZIP upload — <%= comic.title %></h1>
  <a href="/admin/comics/<%= comic.id %>/chapters" class="btn btn-ghost">← Back to chapters</a>
</div>

<% if (error) { %><div class="form-error" style="max-width:560px;"><%= error %></div><% } %>

<p class="hint" style="max-width:560px;margin-bottom:16px;">
  Upload several ZIP files at once — one chapter per ZIP. Each chapter's number is parsed from its filename
  (e.g. <code>12.zip</code>, <code>chapter-12.zip</code>, <code>Ch 12.zip</code> all become Chapter 12).
  Pages inside each ZIP are extracted and sorted automatically.
</p>

<form id="bulkZipForm" action="/admin/comics/<%= comic.id %>/chapters/bulk-zip" method="POST" enctype="multipart/form-data" style="max-width:560px;">
  <div class="field">
    <label for="zips">ZIP files</label>
    <input type="file" id="zips" name="zips" accept=".zip" multiple required />
  </div>
  <div class="field">
    <div class="checkbox-row">
      <input type="checkbox" id="is_premium" name="is_premium" value="1" />
      <label for="is_premium">All of these are premium (VIP-only) chapters</label>
    </div>
  </div>
  <div class="field">
    <label for="publish_at">Schedule for later (optional, applies to all)</label>
    <input type="datetime-local" id="publish_at" name="publish_at" />
    <p class="hint">Leave blank to publish all of them immediately.</p>
  </div>

  <div id="uploadProgressWrap" style="display:none;margin-bottom:14px;">
    <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-mid);margin-bottom:6px;">
      <span id="uploadProgressLabel">Uploading…</span>
      <span id="uploadProgressPercent">0%</span>
    </div>
    <div style="width:100%;height:10px;border-radius:999px;background:var(--panel-2);border:1px solid var(--line);overflow:hidden;">
      <div id="uploadProgressBar" style="width:0%;height:100%;background:linear-gradient(90deg, var(--red), var(--red-bright));transition:width 0.15s ease;"></div>
    </div>
  </div>
  <div id="uploadError" class="form-error" style="display:none;"></div>

  <button type="submit" id="bulkZipSubmitBtn" class="btn btn-red btn-block">Upload all</button>
</form>

<script>
  (function () {
    var form = document.getElementById('bulkZipForm');
    var wrap = document.getElementById('uploadProgressWrap');
    var bar = document.getElementById('uploadProgressBar');
    var percentLabel = document.getElementById('uploadProgressPercent');
    var statusLabel = document.getElementById('uploadProgressLabel');
    var errorBox = document.getElementById('uploadError');
    var submitBtn = document.getElementById('bulkZipSubmitBtn');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errorBox.style.display = 'none';
      wrap.style.display = 'block';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Uploading…';

      var xhr = new XMLHttpRequest();
      xhr.open('POST', form.action, true);

      xhr.upload.onprogress = function (evt) {
        if (!evt.lengthComputable) return;
        var pct = Math.round((evt.loaded / evt.total) * 100);
        bar.style.width = pct + '%';
        percentLabel.textContent = pct + '%';
        if (pct >= 100) statusLabel.textContent = 'Processing on server…';
      };

      xhr.onload = function () {
        if (xhr.status >= 200 && xhr.status < 400) {
          bar.style.width = '100%';
          percentLabel.textContent = '100%';
          statusLabel.textContent = 'Done — redirecting…';
          window.location = xhr.responseURL || '/admin/comics/<%= comic.id %>/chapters';
        } else {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Upload all';
          errorBox.style.display = 'block';
          errorBox.textContent = 'Upload failed (server returned ' + xhr.status + '). Please try again.';
        }
      };

      xhr.onerror = function () {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Upload all';
        errorBox.style.display = 'block';
        errorBox.textContent = 'Upload failed — check your connection and try again.';
      };

      xhr.send(new FormData(form));
    });
  })();
</script>

<%- include('../partials/admin-footer') %>
